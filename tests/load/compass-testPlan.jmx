          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Make this thread&apos;s account">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// One new account per thread. The run ID makes it unique: reusing fixed accounts would fail every
// sign-up with EMAIL_EXISTS or a taken username when a run overlaps another, or follows one that leaked
// accounts. example.com is reserved for testing, so the API sends no welcome email to it.
// Usernames are cut to 25 characters, so keep them short.
def id = &quot;${vars.get(&apos;runId&apos;)}x${ctx.getThreadNum() + 1}&quot;
vars.put(&quot;userEmail&quot;, &quot;loadtest${id}@example.com&quot;)
vars.put(&quot;userPassword&quot;, UUID.randomUUID().toString())
vars.put(&quot;username&quot;, &quot;loadUser${id}&quot;)
vars.put(&quot;name&quot;, &quot;Load Test ${ctx.getThreadNum() + 1}&quot;)</stringProp>
          </JSR223PreProcessor>
