          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Save account for test and teardown" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import org.apache.jmeter.services.FileServer

def token = vars.get(&quot;authToken&quot;)
if (!token) {
    log.warn(&quot;No token for ${vars.get(&apos;userEmail&apos;)}, not saving&quot;)
    return
}
def profileCreated = prev.isSuccessful()
if (!profileCreated) {
    log.warn(&quot;Profile creation failed for ${vars.get(&apos;userEmail&apos;)}, saving anyway so it gets cleaned up&quot;)
}

// profileCreated tells teardown how to delete it: through the API, or only from Firebase
def file = new File(FileServer.getFileServer().getBaseDir(), &quot;created_accounts.txt&quot;)
synchronized (FileServer.class) {
	file.append([vars.get(&quot;userEmail&quot;), vars.get(&quot;userPassword&quot;), token, vars.get(&quot;name&quot;), profileCreated].join(&quot;|&quot;) + &quot;\n&quot;, &quot;UTF-8&quot;)
}</stringProp>
          </JSR223PostProcessor>
