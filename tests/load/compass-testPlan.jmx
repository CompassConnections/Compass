        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="TEARDOWN | Firebase Sign in POST">
          <stringProp name="HTTPSampler.domain">${baseAuthUrl}</stringProp>
          <stringProp name="HTTPSampler.protocol">https</stringProp>
          <stringProp name="HTTPSampler.path">${signinUrl}${firebaseApiKey}</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
          <stringProp name="HTTPSampler.method">POST</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;email&quot;: &quot;${userEmail}&quot;, &quot;password&quot;: &quot;${userPassword}&quot;, &quot;returnSecureToken&quot;: true}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Signed in, or already deleted">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">// An account that no longer exists is already deleted, e.g. a row an older version of this plan left
// in created_accounts.txt after a successful run. Count it as deleted instead of failing it forever.
// Firebase answers INVALID_LOGIN_CREDENTIALS instead of EMAIL_NOT_FOUND when email enumeration
// protection is on, so this also matches a wrong password; the password comes from the file, so it
// is only wrong if the file was edited.
def signedIn = prev.getResponseCode() == &quot;200&quot;
vars.put(&quot;signedIn&quot;, String.valueOf(signedIn))
if (signedIn) return
if (prev.getResponseDataAsString() =~ /EMAIL_NOT_FOUND|INVALID_LOGIN_CREDENTIALS/) {
    prev.setSuccessful(true)
    prev.setResponseMessage(&quot;Account already deleted&quot;)
    props.putIfAbsent(&quot;deletedAccounts&quot;, java.util.concurrent.ConcurrentHashMap.newKeySet())
    props.get(&quot;deletedAccounts&quot;).add(vars.get(&quot;userEmail&quot;))
    return
}
AssertionResult.setFailure(true)
AssertionResult.setFailureMessage(&quot;Sign-in failed with ${prev.getResponseCode()}&quot;)</stringProp>
          </JSR223Assertion>
          <hashTree/>
