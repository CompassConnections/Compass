    <hashTree>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="0 - Check for leftover accounts">
        <stringProp name="ThreadGroup.num_threads">${__P(checkLeftovers,1)}</stringProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="SETUP | Check created_accounts.txt is empty">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import org.apache.jmeter.services.FileServer

def keys = [&quot;setupThreads&quot;, &quot;threads&quot;, &quot;sessionThreads&quot;]

// Properties last until JMeter closes, so in the GUI an earlier run&apos;s zeros are still set.
// Put back what that run changed before checking again.
def saved = props.remove(&quot;leftoverCheckSaved&quot;)
if (saved != null) {
    keys.each { k -&gt; saved.containsKey(k) ? props.put(k, saved[k]) : props.remove(k) }
}

def file = new File(FileServer.getFileServer().getBaseDir(), &quot;created_accounts.txt&quot;)
if (!file.exists()) file.text = &quot;&quot;
def leftovers = file.readLines().findAll { it.trim() }
if (leftovers) {
    def message = &quot;created_accounts.txt lists ${leftovers.size()} accounts from an earlier run. Deleting them instead of running the test; run again afterwards.&quot;
    log.error(message)
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(message)
    // Remember the current values so the next run can put them back
    props.put(&quot;leftoverCheckSaved&quot;, keys.findAll { props.containsKey(it) }.collectEntries { [it, props.getProperty(it)] })
    keys.each { props.put(it, &quot;0&quot;) }
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
