          <elementProp name="firebaseApiKey" elementType="Argument">
            <stringProp name="Argument.name">firebaseApiKey</stringProp>
            <stringProp name="Argument.value">${__P(firebaseApiKey,AIzaSyBspL9glBXWbMsjmtt36dgb2yU0YGGhzKo)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="signupUrl" elementType="Argument">
            <stringProp name="Argument.name">signupUrl</stringProp>
            <stringProp name="Argument.value">/v1/accounts:signUp?key=</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
