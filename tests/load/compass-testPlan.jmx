        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="TEARDOWN | Remove deleted accounts from created_accounts.txt">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import org.apache.jmeter.services.FileServer

// Keep only the accounts teardown couldn&apos;t delete, so a later run (or Cleanup only) can still find them
def deleted = props.remove(&quot;deletedAccounts&quot;) ?: [] as Set
def file = new File(FileServer.getFileServer().getBaseDir(), &quot;created_accounts.txt&quot;)
if (!file.exists()) return
def remaining = file.readLines().findAll { it.trim() &amp;&amp; !deleted.contains(it.split(/\|/)[0]) }
file.setText(remaining ? remaining.join(&quot;\n&quot;) + &quot;\n&quot; : &quot;&quot;, &quot;UTF-8&quot;)
if (remaining) {
    log.warn(&quot;${remaining.size()} accounts could not be deleted and are still listed in created_accounts.txt&quot;)
}</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
